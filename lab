#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6.0", "boto3>=1.35", "google-cloud-compute>=1.20", "google-cloud-storage>=2.18", "google-cloud-iam>=2.15", "google-cloud-resource-manager>=1.12"]
# ///
"""検証環境の構築ツール。どのコマンドも何度実行しても同じ結果になる（docs/design.md 17 章）。

使い方: ./lab <コマンド>（./lab -h で一覧）
uv が Python と依存（PyYAML）を用意するので、事前の準備は uv のインストールだけ。
"""

from __future__ import annotations

import argparse
import sys
import time

from labtool import audit_test, checks, failover, ops, stages
from labtool.core import Env, LabError, ok


def up() -> None:
    env = stages.preflight()
    stages.cluster(env)
    stages.ensure_access(env)
    stages.images(env)
    stages.secrets_(env)
    stages.objectstore(env)
    stages.datastores(env)
    stages.mcp(env)
    stages.litellm(env)
    stages.bootstrap(env)
    stages.audit(env)
    stages.clients(env)
    ops.status(env)


def rebuild() -> None:
    start = time.monotonic()
    ops.down()
    up()
    ok(f"作り直しの所要時間: {int(time.monotonic() - start)} 秒")


def test_failover(pooler: str | None, scenario: str) -> None:
    """障害の試験。--pooler を付けたら、その接続先に切り替えて試し、終わったら元に戻す。"""
    env = Env.load()
    stages.ensure_access(env)
    scenarios = failover.scenarios_for(env) if scenario == "all" else [scenario]
    original = env.get("LAB_DB_POOLER", "pooler")
    switch = pooler is not None and pooler != original and not env.is_aws
    if switch:
        env.set("LAB_DB_POOLER", pooler)
        stages.litellm(env)
    try:
        failover.failover(env, scenarios, audit_check=checks.failover_audit_check(env))
    finally:
        if switch:
            env.set("LAB_DB_POOLER", original)
            stages.litellm(env)


def loaded() -> Env:
    """.env を読み、Kubernetes の API に届く状態にする（VM の環境は 22 の許可の更新と SSH のポート転送）。"""
    env = Env.load()
    stages.ensure_access(env)
    return env


def stage(fn):
    """段階を単独で流す（.env を読んでから呼ぶ）。"""
    return lambda: fn(loaded())


COMMANDS: dict[str, tuple[str, object]] = {
    "up": ("全段階を順に流す（何度でも可）", up),
    "down": ("クラスタを削除する（Mac: k3d。AWS: 有料のものをすべて消す。残るのは無料の証明書と CDK の bootstrap）", ops.down),
    "rebuild": ("クラスタを削除して作り直す（所要時間を表示）", rebuild),
    "status": ("状態を表示する", stage(ops.status)),
    # 段階ごと
    "preflight": ("[段階] 前提の確認", stages.preflight),
    "cluster": ("[段階] Mac: イメージの置き場、k3d、Traefik。aws: CDK の配備、kubeconfig、ESO。"
                "aws-ec2 / gcp-vm: 基盤（API を直接呼ぶ）、k3s、SSH のポート転送、registry、Let's Encrypt", stage(stages.cluster)),
    "images": ("[段階] 検証用 LiteLLM イメージのビルドと push", stage(stages.images)),
    "secrets": ("[段階] 秘密情報（Mac・VM の環境: .env → Secret。aws: Secrets Manager → External Secrets）", stage(stages.secrets_)),
    "objectstore": ("[段階] オブジェクトストレージ（Mac: RustFS を作る。クラウド: バケットの検査）", stage(stages.objectstore)),
    "datastores": ("[段階] PostgreSQL と Redis（aws: Aurora と ElastiCache の確認）", stage(stages.datastores)),
    "mcp": ("[段階] 試験用の偽 LLM と google_workspace_mcp", stage(stages.mcp)),
    "litellm": ("[段階] プロキシ設定、LiteLLM（Helm）、入口", stage(stages.litellm)),
    "bootstrap": ("[段階] 検証ユーザーと固定値のキー", stage(stages.bootstrap)),
    "audit": ("[段階] 監査ログの整形（CronJob）と検索アプリ", stage(stages.audit)),
    "clients": ("[段階] Claude Code と Codex の設定", stage(stages.clients)),
    # 手作業・保守
    "chatgpt-login": ("ChatGPT Plus にデバイスコードでログインする（手作業。初回だけ）", stage(stages.chatgpt_login)),
    "upgrade": ("LiteLLM を別の版でローリング更新する（例: ./lab upgrade v1.104.3）", None),
    "upgrade-k8s": ("aws-ec2 / gcp-vm: k3s（Kubernetes）を 1 台ずつ上げる（例: ./lab upgrade-k8s v1.36.1+k3s1。マイナー版は 1 つずつ）", None),
    "clean-all": ("クラスタ、生成したクライアント設定、ビルドしたイメージを消す（.env とトークンは残す）", None),
    # 試験
    "test-unit": ("単体テスト（構築ツールと、LiteLLM のイメージの中でガードレール）", stage(ops.test_unit)),
    "test-smoke": ("疎通確認（入口、パススルーの遮断、審査の差し替え、機密の持ち出しの拒否）", stage(checks.smoke)),
    "test-idempotency": ("./lab up を 2 回流し、2 回目で何も変わらないことを確かめる", checks.idempotency),
    "test-load": ("偽 LLM を相手にした負荷試験（k6、Docker で実行）", None),
    "test-judge": ("審査官の事例試験（本物の審査官を呼ぶ。ChatGPT の利用枠を使う）", None),
    "test-failover": ("障害の試験（PostgreSQL と Valkey の primary を切り替える・消す・ノードを止める）", None),
    "test-restore": ("PostgreSQL をバックアップから任意の時点に戻す試験", stage(failover.restore)),
    "test-audit": ("監査ログの試験（記録、整形、検索アプリ、精算、改ざんの防止、退避と再送）", stage(audit_test.audit_test)),
    "audit-synth": ("検索の速さの試験用の合成データを作る（audit-derived/synth/）", None),
    "audit-bench": ("検索の速さの試験（合成データと実際の記録で、目標の操作の時間を測る）", None),
    "audit-compact": ("監査ログの整形を手で流す", None),
    "review-log": ("審査の判定ログを集計する", None),
}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="./lab", description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", metavar="<コマンド>", required=True)
    parsers = {name: sub.add_parser(name, help=desc, description=desc) for name, (desc, _) in COMMANDS.items()}
    parsers["upgrade"].add_argument("version", help="LiteLLM の版（例: v1.104.3）")
    parsers["upgrade-k8s"].add_argument("version", help="k3s の版（例: v1.36.1+k3s1）")
    parsers["upgrade-k8s"].add_argument("--measure", action="store_true",
                                        help="上げている間、偽 LLM への要求を流し続けて失敗の数と時間を測る（test-failover と同じ測り方）")
    parsers["clean-all"].add_argument("-y", "--yes", action="store_true", help="確認を出さずに消す")
    parsers["test-load"].add_argument("--vus", default="20", help="同時接続数（既定 20）")
    parsers["test-load"].add_argument("--duration", default="2m", help="時間（既定 2m）")
    parsers["test-load"].add_argument("--scenario", default="chat", choices=["chat", "review"])
    parsers["test-judge"].add_argument("--repeat", type=int, default=3, help="事例ごとの試行回数（既定 3）")
    judge_scope = parsers["test-judge"].add_mutually_exclusive_group()
    judge_scope.add_argument("--context", action="store_true", help="文脈あり審査の事例だけを流す")
    judge_scope.add_argument("--isolated", action="store_true", help="文脈独立審査の事例だけを流す")
    parsers["test-failover"].add_argument("--pooler", choices=["pooler", "direct"],
                                          help="この接続先に切り替えて試す（終わったら元に戻す）")
    parsers["test-failover"].add_argument("--scenario", default="all",
                                          choices=["all", *failover.SCENARIOS_VM, *failover.SCENARIO_ALIASES, *failover.SCENARIOS_AWS],
                                          help="場面（Mac: pg-*, valkey-*。aws-ec2 / gcp-vm: 同じ ＋ entry-node（eip-node でも可）。"
                                               "aws: litellm-drain, aurora-failover, valkey-failover）")
    parsers["audit-synth"].add_argument("--days", type=int, default=7)
    parsers["audit-synth"].add_argument("--per-day", type=int, default=1_000_000)
    parsers["audit-compact"].add_argument("--hour", help="日本時間の時間（YYYY-MM-DDTHH）。省くと締まった時間をすべて")
    parsers["review-log"].add_argument("--since", default="1h", help="集計する期間（既定 1h）")
    parsers["review-log"].add_argument("--raw", action="store_true", help="集計せずに JSON の行を出す")
    args = parser.parse_args(argv)

    try:
        match args.command:
            case "upgrade":
                ops.upgrade(loaded(), args.version)
            case "upgrade-k8s":
                ops.upgrade_k8s(loaded(), args.version, args.measure)
            case "clean-all":
                ops.clean_all(args.yes)
            case "test-load":
                checks.load(loaded(), args.vus, args.duration, args.scenario)
            case "test-judge":
                checks.judge_eval(loaded(), args.repeat,
                                  "context" if args.context else "isolated" if args.isolated else "both")
            case "test-failover":
                test_failover(args.pooler, args.scenario)
            case "audit-synth":
                print(audit_test.run_audit_job(loaded(), "audit-synth", [
                    "python", "-m", "audit.synth", "--days", str(args.days), "--per-day", str(args.per_day)],
                    "audit-compactor-s3", memory="1Gi", timeout=3600))
            case "audit-bench":
                env = loaded()
                for prefix in ("synth/", ""):
                    print(audit_test.run_audit_job(env, "audit-bench", ["python", "-m", "audit.bench", "--prefix", prefix],
                                                   "audit-viewer-s3", memory="512Mi").strip().splitlines()[-1])
            case "audit-compact":
                cmd = ["python", "-m", "audit.compactor"] + (["--hour", args.hour] if args.hour else [])
                print(audit_test.run_audit_job(loaded(), "audit-compact", cmd, "audit-compactor-s3"))
            case "review-log":
                checks.review_log(args.since, args.raw)
            case name:
                COMMANDS[name][1]()
    except LabError as e:
        sys.stderr.write(f"\033[31m[{time.strftime('%H:%M:%S')}] エラー: {e}\033[0m\n")
        return 1
    except KeyboardInterrupt:
        sys.stderr.write("\n中断しました（もう一度流せば、途中から続きます）\n")
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
