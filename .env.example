# 検証環境の設定。`cp .env.example .env` して値を入れる。
# 空のままでよい項目は、./lab up（secrets の段階）が初回に生成して .env に書き足す。
# 一度入った値はスクリプトが上書きしない（特に LITELLM_SALT_KEY は後から変えないこと）。

# ---- 環境 ----
# 向ける環境: local（Mac の k3d。既定）、aws（EKS、Aurora、ElastiCache、S3。.history/2026-10-24-AWS構成/）、
# aws-ec2（EC2 3 台の k3s と S3）、gcp-vm（Compute Engine 3 台の k3s と Cloud Storage）。VM の 2 つは Kubernetes の中が
# Mac と同じ構成で、クラウドの違いは labtool/clouds/ だけ（.history/2026-10-30-VM環境の共通化とGCP追加/）。
# 4 つを同じコードで動かし続ける。審査・監査・検索アプリの層は環境を知らず、違いは ./lab とマニフェストの描画だけ
LAB_TARGET=local
# クラスタ外に残すデータ（chatgpt/ のトークンなど）の置き場所
LAB_DATA_DIR=/Volumes/SSD/litellm-lab
# Mac 側の公開ポート（http://localhost:<port>）
LAB_HTTP_PORT=8080

# ---- クラウド共通（LAB_TARGET が local 以外で読む） ----
# HTTPS のホスト名（必須。例 lab.example.com）。手持ちの DNS に足すもの:
#   aws: ACM の検証用 CNAME（配備の途中で CloudFormation が表示）と、このホスト名 → ALB の DNS 名の CNAME（./lab litellm が表示）
#   aws-ec2 / gcp-vm: 無し（このホスト名 → 浮動 IP の A レコードは ./lab litellm が Cloudflare の API で作る。DNS のみ）
LAB_HOSTNAME=

# ---- AWS（LAB_TARGET=aws と aws-ec2 で読む） ----
# AWS CLI のプロファイル（aws configure sso で作り、aws sso login --profile <名前> でサインインする）。空なら既定
LAB_AWS_PROFILE=
LAB_AWS_REGION=ap-northeast-1
# AZ の末尾（, 区切りでリージョンに足す）。空ならアカウントで使える AZ の先頭 3 つ（使える AZ はアカウントごとに違う）。aws だけ
LAB_AWS_AZS=
# CloudFormation のスタック名、Secrets Manager、ECR、IAM ユーザー、S3 のバケット名の接頭辞
LAB_AWS_STACK_PREFIX=litellm-lab

# ---- VM 3 台（LAB_TARGET=aws-ec2 / gcp-vm のときだけ読む。.history/2026-10-30-VM環境の共通化とGCP追加/） ----
# VM の CIDR（/16。AWS は先頭の /24 × 3 を別 AZ の公開サブネットにし各台は .10（浮動 IP 用に .11）。GCP は先頭の /24 だけで .10〜.12）
LAB_VM_CIDR=10.60.0.0/16
# 各台のディスクの大きさ（GiB）
LAB_VM_DISK_GIB=40
# SSH のポート転送のローカル側のポート（k3s の API 6443 の宛先。kubectl の context litellm-lab-ec2 / litellm-lab-gcp が向く）
LAB_VM_LOCAL_PORT=16443
# ./lab down で浮動 IP（Elastic IP / 静的な外部 IP）を残すか（残しても付いていない間は料金が出る。A レコードはどちらでも次の up が直す）
LAB_VM_KEEP_ENTRY_IP=false
# 22 を開ける送信元（空なら ./lab が毎回パブリック IPv4 を外部に問い合わせて /32 にする。回線が固定なら書いて固定できる）
LAB_SSH_ALLOW_CIDR=
# 80/443（入口）を開ける送信元（空なら 22 と同じ操作者の IP。公開の入口には API キーの総当たりが来るので、検証環境は絞る。
# 他の回線からも使うなら CIDR を書く。0.0.0.0/0 で全開）
LAB_WEB_ALLOW_CIDR=
# 2 つの審査官（review-judge、isolated-judge）の Anthropic の API キーとモデル（従量。Anthropic Console で利用上限を設ける）
LAB_JUDGE_ANTHROPIC_API_KEY=
LAB_VM_JUDGE_MODEL=claude-haiku-4-5-20251001
# AWS の台の種類（Graviton）。t4g.large（8 GiB）× 3 が既定。t4g.medium（4 GiB）なら費用は半分だが配置がぎりぎり
LAB_EC2_INSTANCE_TYPE=t4g.large
# GCP: プロジェクト ID（gcp-vm で必須）、リージョン（ゾーンは先頭 3 つ）、台の種類（C4A、Axion arm64）、資源の名前の接頭辞
LAB_GCP_PROJECT=
LAB_GCP_REGION=asia-northeast1
LAB_GCP_MACHINE_TYPE=c4a-standard-2
LAB_GCP_PREFIX=litellm-lab
# Let's Encrypt（cert-manager の DNS-01、Cloudflare）。API トークンは「Zone / DNS / Edit」をそのゾーンに限って発行する
LAB_CLOUDFLARE_API_TOKEN=
LAB_ACME_EMAIL=
# true なら Let's Encrypt の staging（発行数の上限を避ける。ブラウザには警告が出る）
LAB_ACME_STAGING=false
# クラスタの中のイメージ置き場（registry）の HTTP の秘密（2 Pod で同じ値にする。空なら生成）
LAB_REGISTRY_HTTP_SECRET=
# ---- EKS 版だけ（LAB_TARGET=aws） ----
# ALB の種類: internet-facing（検証。IP 制限なし）か internal（本番。VPN か Direct Connect で届く）
LAB_AWS_ALB_SCHEME=internet-facing
# 規模（検証相当）。Aurora Serverless v2 の上限 ACU と自動停止までの分、ElastiCache のノードの種類、NAT の数
LAB_AWS_AURORA_MAX_ACU=4
LAB_AWS_AURORA_PAUSE_MINUTES=20
LAB_AWS_VALKEY_NODE_TYPE=cache.t4g.micro
LAB_AWS_NAT_GATEWAYS=1
LAB_EKS_VERSION=1.35
# Bedrock のモデル ID（EKS 版の Claude Code 用。日本内で処理するプロファイル）。Opus は日本内のプロファイルが無いので既定は空
LAB_BEDROCK_SONNET=jp.anthropic.claude-sonnet-4-5-20250929-v1:0
LAB_BEDROCK_HAIKU=jp.anthropic.claude-haiku-4-5-20251001-v1:0
LAB_BEDROCK_OPUS=
# 2 つの審査官（review-judge、isolated-judge）の Bedrock のモデル ID。空なら LAB_BEDROCK_HAIKU と同じ
LAB_AWS_JUDGE_MODEL=

# ---- 自動生成（空のままでよい。LAB_TARGET=aws ではここに書かず、Secrets Manager の <接頭辞>/app に生成する） ----
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Valkey の Sentinel のパスワード（REDIS_PASSWORD は Valkey のデータの Pod のパスワード）
SENTINEL_PASSWORD=
# オブジェクトストレージ（RustFS）の管理者と、用途ごとの利用者（アクセスキーは利用者の名前、シークレットは生成）
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
S3_LITELLM_WRITER_KEY=
S3_LITELLM_WRITER_SECRET=
S3_AUDIT_COMPACTOR_KEY=
S3_AUDIT_COMPACTOR_SECRET=
S3_AUDIT_VIEWER_KEY=
S3_AUDIT_VIEWER_SECRET=
S3_PG_BACKUP_KEY=
S3_PG_BACKUP_SECRET=
# 利用者ごとのキー（クラスタを作り直しても同じ値で作り直す）
LAB_KEY_USER1_CLAUDE=
LAB_KEY_USER1_CODEX=
LAB_KEY_USER2_CLAUDE=
LAB_KEY_USER2_CODEX=
# 審査を外したキー（ユーザー 1 の検証用）。true のとき ./lab が下の 2 つを生成・登録し、
# clients/codex-lab-noreview・clients/claude-lab-noreview で起動できる（docs/manual-check.md）。
# 審査を通らずに使えるキーなので、検証が済んだら false に戻して ./lab up を流すと消える。
LAB_NOREVIEW_KEYS=false
LAB_KEY_USER1_CLAUDE_NOREVIEW=
LAB_KEY_USER1_CODEX_NOREVIEW=

# ---- 検証ユーザー（Google アカウント） ----
# 1 人目は管理者（PROXY_ADMIN_ID）になる
LAB_USER1_EMAIL=
LAB_USER2_EMAIL=

# ---- Google Cloud（手作業で作成。docs/setup-google.md） ----
# SSO と Gmail の MCP で同じ OAuth クライアントを使う
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- TypeSafe Jev（一次判定） ----
TYPESAFE_API_KEY=
# 一次判定を使うか（true / false）
LAB_USE_JEV=true
LAB_JEV_THRESHOLD=0.2

# ---- ChatGPT Plus（chatgpt/ プロバイダ） ----
# Codex が使うモデル（LiteLLM の model_name と chatgpt/ のモデル名）。
# ChatGPT のアカウントで使える名前にする（Codex 本体の /model の一覧、~/.codex/models_cache.json で分かる）。
# gpt-5.3-codex は ChatGPT のアカウントでは使えなかった（2026-10-11）
LAB_CODEX_MODEL=gpt-5.6-terra
# 二次判定に使うモデル
LAB_JUDGE_MODEL=gpt-5.6-luna

# ---- 文脈独立の審査（機密情報の持ち出し） ----
# 会話を見ずに、ツール名・引数・ツールの定義だけで判定する審査を、文脈あり審査と並列に行うか
LAB_ISOLATED_REVIEW=true
# Claude Code のツールコールにも行うか
LAB_ISOLATED_CLAUDE_CODE=true
# 審査官（isolated-judge）が使う ChatGPT のモデル。空なら LAB_JUDGE_MODEL と同じ
LAB_ISOLATED_JUDGE_MODEL=
# 判定基準（何が機密か、どこが社内か）のファイル。変えたら ./lab litellm で反映する
LAB_ISOLATED_POLICY_FILE=litellm/guardrails/policies/confidential.md
# 中身の審査（要求に方針を足し、送るファイルや動かすプログラムを送る前・動かす前にモデル自身に読ませ、
# ゲートウェイが確かめた中身を審査官に渡す）
LAB_ISOLATED_CONTENT=true
# 1 ファイルの大きさの上限（バイト）。Claude Code は約 30,000 文字を超える出力を先頭しか渡さないので、それより小さくする
LAB_ISOLATED_CONTENT_MAX_BYTES=24576
# 1 回の読み取りで読ませるファイルと環境変数の数の上限（送るファイル、プログラム、取り込むファイル、設定ファイル、環境変数の合計）
LAB_ISOLATED_CONTENT_MAX_FILES=5
# 送信してよい宛先（カンマ区切り。private=プライベートアドレスの範囲、CIDR、ホスト名・ドメイン（末尾一致）、*=すべて）。
# 外へ送る操作すべてに効く（GitHub への push、メールの送信も）。例: private,github.com,gmail.com
LAB_ISOLATED_DESTINATIONS=private

# ---- DB とオブジェクトストレージ ----
# LiteLLM の DB の接続先: pooler（PgBouncer。既定）か direct（PostgreSQL の primary に直結）
LAB_DB_POOLER=pooler
# Pod から見た S3 互換ストレージの接続先（AWS S3 などに置き換えるときに変える）
LAB_S3_ENDPOINT=http://rustfs:9000
LAB_S3_REGION=us-east-1

# LiteLLM の版（./lab upgrade <版> が書き換える）
LAB_LITELLM_VERSION=v1.104.2
