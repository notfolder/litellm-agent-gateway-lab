# 検証環境の設定。`cp .env.example .env` して値を入れる。
# 空のままでよい項目は、scripts/30-secrets.sh が初回に生成して .env に書き足す。
# 一度入った値はスクリプトが上書きしない（特に LITELLM_SALT_KEY は後から変えないこと）。

# ---- 環境 ----
# クラスタ外に残すデータ（chatgpt/ のトークンなど）の置き場所
LAB_DATA_DIR=/Volumes/SSD/litellm-lab
# Mac 側の公開ポート（http://localhost:<port>）
LAB_HTTP_PORT=8080

# ---- 自動生成（空のままでよい） ----
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 利用者ごとのキー（クラスタを作り直しても同じ値で作り直す）
LAB_KEY_USER1_CLAUDE=
LAB_KEY_USER1_CODEX=
LAB_KEY_USER2_CLAUDE=
LAB_KEY_USER2_CODEX=

# ---- 検証ユーザー（Google アカウント） ----
# 1 人目は管理者（PROXY_ADMIN_ID）になる
LAB_USER1_EMAIL=
LAB_USER2_EMAIL=

# ---- Google Cloud（手作業で作成。docs/setup-google.md） ----
# SSO と Gmail の MCP で同じ OAuth クライアントを使う
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- TypeSafe Jev（一次判定） ----
TYPESAFE_API_KEY=
# 一次判定を使うか（true / false）
LAB_USE_JEV=true
LAB_JEV_THRESHOLD=0.2

# ---- ChatGPT Plus（chatgpt/ プロバイダ） ----
# Codex が使うモデル（LiteLLM の model_name と chatgpt/ のモデル名）。
# 契約後に Codex の /model で選べる名前を確かめて直す（GPT-5.5 は 2026-10-14 に退役予定）
LAB_CODEX_MODEL=gpt-5.3-codex
# 二次判定に使うモデル
LAB_JUDGE_MODEL=gpt-5.1-codex-mini

# LiteLLM の版（make upgrade VERSION=... が書き換える）
LAB_LITELLM_VERSION=v1.104.2
