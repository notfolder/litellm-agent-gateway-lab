#!/usr/bin/env bash
# 検証用の LiteLLM を通して Codex を起動する。CODEX_HOME を .codex-lab に分けるので、普段の ~/.codex は使わない。
# Gmail の MCP を初めて使うときは、先に: clients/codex-lab mcp login gmail
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[[ -f "$here/out/codex.env" ]] || { echo "clients/out/codex.env がありません。./lab clients を実行してください" >&2; exit 1; }
# shellcheck disable=SC1091
source "$here/out/codex.env"
# mcp login のときは LiteLLM のキーを付けない。キーが付いていると、LiteLLM が 401（サインインの要求）ではなく
# 通常の応答を返すので、Codex がサインインの手順を見つけられずに失敗する（2026-10-11 に確認）
if [[ "${1:-}" == "mcp" && "${2:-}" == "login" ]]; then
  unset LITELLM_MCP_AUTH
fi
exec codex "$@"
