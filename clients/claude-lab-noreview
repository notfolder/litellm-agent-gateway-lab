#!/usr/bin/env bash
# 審査を外したキー（user1-claude-noreview）で Claude Code を起動する（検証用。docs/manual-check.md）。
# .env の LAB_NOREVIEW_KEYS=true にして ./lab up（または ./lab clients）を流すと使えるようになる。
# 認証は普段どおり Claude Max のサインインを使う（ANTHROPIC_API_KEY などは設定しない）。
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[[ -f "$here/out/noreview-claude.env" && -f "$here/out/noreview-mcp.json" ]] || {
  echo "clients/out/noreview-claude.env がありません。.env の LAB_NOREVIEW_KEYS=true にして ./lab up を実行してください" >&2
  exit 1
}
# shellcheck disable=SC1091
source "$here/out/noreview-claude.env"
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
exec claude --settings "$here/out/claude-settings.json" --mcp-config "$here/out/noreview-mcp.json" "$@"
